# ── Email (Gmail SMTP) ─────────────────────────────────────────────────────────
# Gmail address you'll send FROM (can be any Gmail account)
EMAIL_USER=your-gmail@gmail.com

# Gmail "App Password" — NOT your regular Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification to be enabled on the account)
EMAIL_PASS=xxxx-xxxx-xxxx-xxxx

# Email address(es) that receive new quote notifications
NOTIFY_EMAIL=anthonypabraham09@gmail.com

# ── Twilio SMS (optional — delete these lines to disable SMS) ─────────────────
# Sign up at https://twilio.com — free trial gives $15 credit
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_FROM=+1XXXXXXXXXX   # Your Twilio phone number
NOTIFY_PHONE=+15863472067  # The number to text when a quote comes in

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
